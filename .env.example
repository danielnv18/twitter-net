# Optional overrides; Compose works with development defaults without this file.
MYSQL_DATABASE=twitter_net
MYSQL_USER=twitter_net
MYSQL_PASSWORD=twitter_net_dev
MYSQL_ROOT_PASSWORD=root_dev
API_PORT=8080
CLIENT_PORT=5173

# LOCAL LOOPBACK HTTP ONLY. Keep false for public HTTPS deployments.
AUTH_ALLOW_INSECURE_HTTP=false
# Nginx client container address on the private Compose network.
AUTH_TRUSTED_PROXY_IP=172.30.0.10
